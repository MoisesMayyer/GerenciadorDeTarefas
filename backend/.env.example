# Copie para backend/.env e ajuste os valores.
# Gere a SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/gerenciadortarefas

CORS_ORIGINS=https://moisesmayyer.github.io,http://localhost:5500,http://127.0.0.1:5500

# Opcional: sobrescreve o banco usado pelos testes.
# Se omitido, o conftest usa DATABASE_URL trocando o nome por test_gerenciador_tarefas.
# TEST_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/test_gerenciador_tarefas
